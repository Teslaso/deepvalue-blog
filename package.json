{
  "name": "deepvalue-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test tests/*.test.mjs",
    "sync": "npm run build",
    "prepare:publish": "node scripts/prepare-publish.mjs",
    "publish:check": "npm run prepare:publish && npm run build",
    "publish:current": "node publisher/cli.mjs current",
    "publish:pending": "node publisher/cli.mjs pending",
    "publish:test": "node --test tests/publisher-*.test.mjs",
    "studio": "node publisher/studio.mjs",
    "studio:test": "node --test tests/studio-*.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@fontsource/bebas-neue": "^5.2.7",
    "@fontsource/inter": "^5.2.7",
    "@fontsource/space-mono": "^5.2.7",
    "astro": "^6.1.6",
    "entities": "^6.0.1",
    "gray-matter": "4.0.3",
    "lz-string": "^1.5.0",
    "marked": "^18.0.7",
    "marked-footnote": "^1.4.0",
    "sanitize-html": "^2.17.6",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
