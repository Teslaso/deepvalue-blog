---
import Base from '../../layouts/Base.astro';
---

<Base title="关于 - Deep Value" description="关注投资、交易、大宗商品与量化交易，持续学习和实践。">
  <header class="about-header">
    <div class="about-kicker">
      <p data-i18n="about.kicker">ABOUT ME</p>
      <span data-i18n="about.independent">LEARNING IN PUBLIC</span>
    </div>
    <div class="about-introduction">
      <h1 data-i18n="about.title">关于</h1>
      <p data-i18n="about.intro">我关注投资、交易、大宗商品与量化交易。目前还在学习阶段，保持热爱，持续学习和实践。</p>
    </div>
  </header>
</Base>

<style>
  .about-header {
    display: grid;
    grid-template-columns: minmax(9rem, 0.25fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6.5rem);
    padding: clamp(2rem, 5vw, 4.75rem) 0 var(--space-6);
    border-bottom: 1px solid var(--color-ink);
  }

  .about-kicker {
    display: grid;
    align-content: space-between;
    min-height: 10rem;
    color: var(--metadata-primary);
    font-family: var(--font-data);
    font-size: var(--caption);
    letter-spacing: 0.1em;
    line-height: 1.6;
  }

  .about-kicker p,
  .about-introduction h1,
  .about-introduction p {
    margin: 0;
  }

  .about-kicker span {
    color: var(--link-primary);
  }

  .about-introduction {
    display: grid;
    gap: var(--space-3);
  }

  .about-introduction h1 {
    font-size: var(--step-4);
    font-weight: var(--weight-medium);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .about-introduction p {
    max-width: 46rem;
    font-size: var(--step-1);
    line-height: 1.8;
  }

  @media (max-width: 700px) {
    .about-header {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .about-header {
      padding-top: var(--space-4);
    }

    .about-kicker {
      display: flex;
      min-height: 0;
      justify-content: space-between;
    }

    .about-introduction h1 {
      font-size: var(--step-3);
    }

  }
</style>
