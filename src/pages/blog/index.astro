---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getPublishedEntries } from '../../lib/entries.mjs';
import { sortEntriesByPublishedNewestFirst } from '../../lib/entry-utils.mjs';

const sortedPosts = sortEntriesByPublishedNewestFirst(
  await getPublishedEntries({ format: 'article' }),
);
---

<Base title="博客 - Deep Value" description="Deep Value 的全部已发布文章列表">
  <header class="article-index-header">
    <div class="article-index-kicker">
      <p>DEEP VALUE</p>
      <span>ALL ARTICLES</span>
    </div>
    <div class="article-index-copy">
      <h1 data-i18n="publication.blogTitle">博客</h1>
      <p data-i18n="publication.blogDescription">所有文章按时间排列，慢慢阅读。</p>
    </div>
  </header>

  <section class="article-index-list" aria-labelledby="article-list-title">
    <header>
      <div>
        <p data-i18n="index.entryIndex">ARTICLE INDEX</p>
        <h2 id="article-list-title" data-i18n="index.articleList">全部文章</h2>
      </div>
      <span>{String(sortedPosts.length).padStart(2, '0')} PUBLISHED</span>
    </header>

    <EntryList
      entries={sortedPosts}
      emptyText="暂时没有已发布的文章。"
      emptyTextKey="publication.blogEmpty"
      dateMode="published"
    />
  </section>
</Base>

<style>
  .article-index-header {
    display: grid;
    grid-template-columns: minmax(9rem, 0.25fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6.5rem);
    padding: clamp(2rem, 5vw, 4.75rem) 0 var(--space-6);
    border-bottom: 1px solid var(--color-ink);
  }

  .article-index-kicker {
    display: grid;
    align-content: space-between;
    min-height: 9rem;
    color: var(--metadata-primary);
    font-family: var(--font-data);
    font-size: var(--caption);
    letter-spacing: 0.1em;
    line-height: 1.6;
  }

  .article-index-kicker p,
  .article-index-copy h1,
  .article-index-copy p {
    margin: 0;
  }

  .article-index-kicker span {
    color: var(--link-primary);
  }

  .article-index-copy {
    display: grid;
    gap: var(--space-3);
  }

  .article-index-copy h1 {
    font-size: var(--step-4);
    font-weight: var(--weight-medium);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .article-index-copy p {
    max-width: 46rem;
    color: var(--text-secondary);
    font-size: var(--step-1);
    line-height: 1.75;
  }

  .article-index-list {
    width: min(100%, 58rem);
    margin: var(--space-6) auto 0;
  }

  .article-index-list > header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-ink);
  }

  .article-index-list > header p,
  .article-index-list > header h2,
  .article-index-list > header span {
    margin: 0;
  }

  .article-index-list > header p,
  .article-index-list > header span {
    color: var(--metadata-primary);
    font-family: var(--font-data);
    font-size: var(--caption);
    letter-spacing: 0.09em;
  }

  .article-index-list > header h2 {
    margin-top: var(--space-1);
    font-size: var(--step-3);
    font-weight: var(--weight-medium);
    line-height: 1.15;
  }

  @media (max-width: 760px) {
    .article-index-header {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding-top: var(--space-4);
    }

    .article-index-kicker {
      display: flex;
      min-height: 0;
      justify-content: space-between;
    }

    .article-index-copy h1 {
      font-size: var(--step-3);
    }

    .article-index-list {
      margin-top: var(--space-5);
    }
  }
</style>
