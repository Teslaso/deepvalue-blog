---
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { getPublishedEntries } from '../lib/entries.mjs';
import { sortEntriesByPublishedNewestFirst } from '../lib/entry-utils.mjs';
const allArticles = sortEntriesByPublishedNewestFirst(
  await getPublishedEntries({ format: 'article' }),
);
---
<Base
  title="Deep Value Research"
  description="记录产业研究、交易实践与 AI 应用。"
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">INDUSTRY RESEARCH · TRADING · APPLIED AI</p>
        <h1 id="hero-title">
          <span class="hero-title-line" data-i18n="home.heroTitleResearch">产业研究</span>
          <span class="hero-title-line" data-i18n="home.heroTitleTrading">交易</span>
          <span class="hero-title-line" data-i18n="home.heroTitleAI">AI 应用</span>
        </h1>
        <p class="hero-intro" data-i18n="home.heroIntro">
          记录产业研究、交易实践与 AI 应用。
        </p>
        <div class="hero-actions">
          <a class="text-link" href="/investment/" data-i18n="home.heroCta">进入投资研究</a>
        </div>
      </div>
      <aside class="hero-index" data-i18n-aria-label="home.researchScope" aria-label="研究范围">
        <div class="hero-index-row"><span>01</span><span data-i18n="home.indexResearch">产业研究</span></div>
        <div class="hero-index-row"><span>02</span><span data-i18n="home.indexTrading">市场与交易</span></div>
        <div class="hero-index-row"><span>03</span><span data-i18n="home.indexAI">AI 应用</span></div>
      </aside>
    </div>
  </section>
  <div class="paper">
    <div class="content-frame">
      <section class="all-articles-section" aria-labelledby="all-articles-heading">
        <div class="section-label">
          <div>
            <p data-i18n="index.entryIndex">ARTICLE INDEX</p>
            <h2 id="all-articles-heading" data-i18n="index.articleList">全部文章</h2>
          </div>
          <span>{String(allArticles.length).padStart(2, '0')} <span data-i18n="index.published">PUBLISHED</span></span>
        </div>
        <EntryList
          entries={allArticles}
          emptyText="暂时没有已发布的研究文章。"
          emptyTextKey="publication.blogEmpty"
          dateMode="published"
        />
      </section>
    </div>
  </div>
</Base>
<style>
  .hero {
    position: relative;
    display: grid;
    min-height: min(920px, 100svh);
    overflow: hidden;
    color: var(--text-inverse);
    background-color: var(--color-ink);
    isolation: isolate;
  }
  .hero::before {
    position: absolute;
    inset: 0;
    z-index: -3;
    content: "";
    background-image: url("/images/brand/commodities-macro-hero.avif");
    background-position: center 54%;
    background-size: cover;
    transform: scale(1.015);
  }
  .hero::after {
    position: absolute;
    inset: 0;
    z-index: -2;
    content: "";
    background:
      linear-gradient(90deg, rgb(11 12 11 / 94%) 0%, rgb(11 12 11 / 74%) 34%, rgb(11 12 11 / 18%) 72%),
      linear-gradient(0deg, rgb(11 12 11 / 90%) 0%, transparent 46%, rgb(11 12 11 / 26%) 100%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(240px, 0.55fr);
    align-items: end;
    width: min(1440px, 100%);
    min-height: inherit;
    margin: 0 auto;
    padding: calc(var(--header-height) + 7rem) 3.2vw 4.25rem;
    animation: hero-arrive var(--duration-entrance) var(--ease-editorial) both;
  }
  .hero-copy {
    align-self: end;
    max-width: 840px;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0;
    font-family: var(--font-data);
    font-size: var(--caption);
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .eyebrow::before {
    width: 2.6rem;
    height: 1px;
    content: "";
    background: currentColor;
  }
  .hero .eyebrow {
    color: var(--color-copper-on-ink);
  }
  .hero h1 {
    max-width: none;
    margin: 1.15rem 0 1.5rem;
    font-size: clamp(3.75rem, 5vw, 5.4rem);
    font-weight: var(--weight-medium);
    letter-spacing: -0.035em;
    line-height: 0.98;
  }
  .hero-title-line {
    display: block;
    white-space: nowrap;
  }
  .hero-intro {
    max-width: 650px;
    margin: 0;
    color: color-mix(in srgb, var(--color-paper) 82%, transparent);
    font-size: var(--body-large);
    line-height: 1.85;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2.4rem;
  }
  .text-link,
  .module-link,
  .row-link {
    font-family: var(--font-data);
    font-size: 0.73rem;
    letter-spacing: 0.08em;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    min-width: 11rem;
    min-height: 48px;
    padding: 0.7rem 0;
    border-bottom: 1px solid currentColor;
    transition: color var(--duration-fast) linear, padding var(--duration-base) var(--ease-editorial);
  }
  .text-link:hover {
    padding-left: 0.4rem;
    color: var(--color-copper-on-ink);
  }
  .hero-index {
    align-self: end;
    margin-left: 3rem;
    border-top: 1px solid var(--border-subtle-inverse);
  }
  .hero-index-row {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.5rem;
    padding: 0.9rem 0;
    color: var(--text-inverse-muted);
    border-bottom: 1px solid var(--border-subtle-inverse);
    font-family: var(--font-data);
    font-size: var(--caption);
    line-height: 1.5;
  }
  .hero-index-row span:first-child {
    color: var(--color-copper-on-ink);
  }
  .paper {
    color: var(--text-primary);
    background-color: var(--surface-primary);
    background-image: linear-gradient(
      color-mix(in srgb, var(--color-ink) 2.2%, transparent) 1px,
      transparent 1px
    );
    background-size: 100% 9px;
  }
  .issue-bar {
    display: grid;
    grid-template-columns: 1.15fr 1fr 0.8fr;
    width: min(1440px, 100%);
    min-height: 66px;
    margin: 0 auto;
    border-right: 1px solid var(--border-subtle);
    border-left: 1px solid var(--border-subtle);
  }
  .issue-bar span {
    display: flex;
    align-items: center;
    padding: 0 1.5rem;
    border-right: 1px solid var(--border-subtle);
    font-family: var(--font-data);
    font-size: var(--caption);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .issue-bar span:last-child {
    border-right: 0;
  }
  .issue-bar .olive {
    color: var(--metadata-primary);
  }
  .content-frame {
    width: min(1440px, 100%);
    margin: 0 auto;
    border: 1px solid var(--border-subtle);
    border-bottom: 0;
  }
  .section-label {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    min-height: 64px;
    padding: 0 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
    font-family: var(--font-data);
    font-size: var(--caption);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .section-label h2 {
    margin: 0;
    font: inherit;
  }
  .section-label > :last-child {
    color: var(--metadata-primary);
    letter-spacing: 0.04em;
  }
  .section-label a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    transition: color var(--duration-fast) linear;
  }
  .section-label a:hover {
    color: var(--link-primary);
  }
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(300px, 0.45fr);
    min-height: 640px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .feature-main {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(2rem, 5vw, 5.5rem);
    border-right: 1px solid var(--border-subtle);
  }
  .feature-kicker,
  .meta-line,
  .rail-label,
  .confidence,
  .entry-meta,
  .entry-index,
  .module-heading,
  .module-empty span,
  .compact-list time,
  .beyond-title > span {
    font-family: var(--font-data);
    font-size: var(--caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .feature-kicker {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--link-primary);
  }
  .feature-main h3 {
    max-width: 17ch;
    margin: 2.5rem 0 2rem;
    font-size: clamp(2.4rem, 5vw, 5.6rem);
    font-weight: var(--weight-medium);
    letter-spacing: -0.035em;
    line-height: 1.06;
  }
  .feature-summary {
    max-width: 690px;
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--body-large);
    line-height: 1.9;
  }
  .meta-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.2rem;
    margin-top: 3rem;
    padding-top: 1.2rem;
    color: var(--metadata-primary);
    border-top: 1px solid var(--border-subtle);
  }
  .feature-link {
    align-self: flex-start;
    min-width: min(100%, 15rem);
    margin-top: 2rem;
    color: var(--link-primary);
  }
  .feature-rail {
    display: grid;
    grid-template-rows: auto 1fr auto;
  }
  .rail-label {
    padding: 1.4rem 1.5rem;
    color: var(--metadata-primary);
    border-bottom: 1px solid var(--border-subtle);
  }
  .thesis {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2.25rem 1.5rem;
  }
  .thesis > span {
    margin-bottom: 1.5rem;
    color: var(--link-primary);
    font-family: var(--font-data);
    font-size: var(--caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .thesis p {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.75;
  }
  .confidence {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    padding: 1.4rem 1.5rem;
    color: var(--metadata-primary);
    border-top: 1px solid var(--border-subtle);
  }
  .featured-empty,
  .section-empty {
    padding: clamp(3rem, 8vw, 8rem) 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .featured-empty p,
  .section-empty p {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--step-1);
  }
  .investment-list,
  .compact-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .investment-list li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: start;
    min-height: 230px;
    padding: 2rem 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .investment-list li.has-preview {
    grid-template-columns: 4.5rem minmax(0, 1fr) clamp(220px, 23vw, 320px) auto;
  }
  .entry-index {
    padding-top: 0.25rem;
    color: var(--link-primary);
  }
  .entry-copy {
    max-width: 880px;
  }
  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin: 0 0 1rem;
    color: var(--metadata-primary);
  }
  .entry-copy h3 {
    max-width: 24ch;
    margin: 0;
    font-size: clamp(1.55rem, 1.25rem + 1vw, 2.15rem);
    font-weight: var(--weight-medium);
    letter-spacing: -0.025em;
    line-height: 1.14;
  }
  .entry-copy h3 a {
    transition: color var(--duration-fast) linear;
  }
  .entry-copy h3 a:hover {
    color: var(--link-primary);
  }
  .entry-summary {
    max-width: 760px;
    margin: 1.25rem 0 0;
    color: var(--text-secondary);
    line-height: 1.85;
  }
  .entry-preview {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--surface-secondary);
  }
  .entry-preview img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-base) var(--ease-editorial);
  }
  .entry-preview:hover img {
    transform: scale(1.015);
  }
  .row-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--link-primary);
    border-bottom: 1px solid currentColor;
  }
  .secondary-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-bottom: 1px solid var(--border-subtle);
  }
  .desk-module {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 440px;
    padding: 0 1.5rem 1.5rem;
    border-right: 1px solid var(--border-subtle);
  }
  .desk-module:last-child {
    border-right: 0;
  }
  .module-heading {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
    align-items: center;
    min-height: 72px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .module-heading > span {
    color: var(--link-primary);
  }
  .module-heading h2 {
    margin: 0;
    font: inherit;
  }
  .module-empty {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2.5rem 0;
  }
  .module-empty p {
    max-width: 34rem;
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--step-1);
    line-height: 1.8;
  }
  .module-empty span {
    margin-top: 2rem;
    padding-top: 1rem;
    color: var(--metadata-primary);
    border-top: 1px solid var(--border-subtle);
  }
  .compact-list li {
    display: grid;
    gap: 0.6rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .compact-list time {
    color: var(--metadata-primary);
  }
  .compact-list a {
    font-size: var(--step-1);
    line-height: 1.4;
    transition: color var(--duration-fast) linear;
  }
  .compact-list a:hover {
    color: var(--link-primary);
  }
  .module-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    margin-top: 1.5rem;
    color: var(--link-primary);
    border-bottom: 1px solid currentColor;
    transition: color var(--duration-fast) linear;
  }
  .module-link:hover {
    color: var(--text-primary);
  }
  .method {
    display: grid;
    grid-template-columns: 0.65fr 1.35fr;
    min-height: 430px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .method-title {
    padding: 3rem 1.5rem;
    border-right: 1px solid var(--border-subtle);
  }
  .method-title .eyebrow {
    color: var(--link-primary);
  }
  .method-title h2 {
    max-width: 7ch;
    margin: 1.6rem 0 0;
    font-size: var(--h2);
    font-weight: var(--weight-medium);
    line-height: 1.08;
  }
  .method-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }
  .method-item {
    padding: 3rem 1.8rem;
    border-right: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }
  .method-item:nth-child(2n) {
    border-right: 0;
  }
  .method-item:nth-last-child(-n + 2) {
    border-bottom: 0;
  }
  .method-item strong {
    display: block;
    margin-bottom: 1rem;
    color: var(--link-primary);
    font-family: var(--font-data);
    font-size: var(--caption);
    letter-spacing: 0.08em;
  }
  .method-item p {
    margin: 0;
    line-height: 1.8;
  }
  .beyond-module {
    display: grid;
    grid-template-columns: minmax(240px, 0.65fr) minmax(0, 1.35fr);
    min-height: 330px;
    color: color-mix(in srgb, var(--color-ink) 82%, var(--color-paper));
    background: var(--surface-secondary);
  }
  .beyond-title,
  .beyond-content {
    padding: 3rem 1.5rem;
  }
  .beyond-title {
    border-right: 1px solid var(--border-subtle);
  }
  .beyond-title > span {
    color: var(--metadata-primary);
  }
  .beyond-title h2 {
    max-width: 11ch;
    margin: 1.25rem 0 0;
    font-size: var(--step-2);
    font-weight: var(--weight-medium);
    line-height: 1.25;
  }
  .beyond-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .beyond-content > p {
    max-width: 640px;
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.85;
  }
  @keyframes hero-arrive {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) 270px;
    }
    .featured {
      grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    }
    .investment-list li {
      grid-template-columns: 3rem minmax(0, 1fr);
    }
    .investment-list li.has-preview {
      grid-template-columns: 3rem minmax(0, 1fr) minmax(200px, 28vw, 280px);
    }
    .investment-list li.has-preview .entry-preview {
      grid-column: 3;
      grid-row: 1 / span 2;
    }
    .row-link {
      grid-column: 2;
      justify-self: start;
    }
  }
  @media (max-width: 820px) {
    .hero {
      min-height: 860px;
    }
    .hero::before {
      background-position: 62% center;
    }
    .hero::after {
      background:
        linear-gradient(90deg, rgb(11 12 11 / 91%) 0%, rgb(11 12 11 / 53%) 65%, rgb(11 12 11 / 28%) 100%),
        linear-gradient(0deg, rgb(11 12 11 / 96%) 0%, rgb(11 12 11 / 18%) 72%);
    }
    .hero-grid {
      grid-template-columns: 1fr;
      padding-top: calc(var(--header-height) + 4.5rem);
      padding-bottom: 2rem;
    }
    .hero h1 {
      max-width: none;
    }
    .hero-index {
      margin: 3rem 0 0;
    }
    .investment-list li,
    .investment-list li.has-preview {
      grid-template-columns: 3rem minmax(0, 1fr);
    }
    .investment-list li.has-preview .entry-preview {
      grid-column: 2;
      grid-row: auto;
      max-width: none;
    }
    .row-link {
      grid-column: 2;
      justify-self: start;
    }
    .issue-bar {
      grid-template-columns: 1fr auto;
    }
    .issue-bar span:nth-child(2) {
      display: none;
    }
    .featured,
    .method,
    .beyond-module {
      grid-template-columns: 1fr;
    }
    .feature-main,
    .method-title,
    .beyond-title {
      border-right: 0;
      border-bottom: 1px solid var(--border-subtle);
    }
    .featured {
      min-height: 0;
    }
    .feature-rail {
      min-height: 360px;
    }
    .secondary-grid {
      grid-template-columns: 1fr;
    }
    .desk-module {
      min-height: 380px;
      border-right: 0;
      border-bottom: 1px solid var(--border-subtle);
    }
    .desk-module:last-child {
      border-bottom: 0;
    }
  }
  @media (max-width: 560px) {
    .hero-grid {
      padding-right: 1rem;
      padding-left: 1rem;
    }
    .hero h1 {
      font-size: clamp(2.5rem, 11.5vw, 3.25rem);
    }
    .hero-intro {
      font-size: 1rem;
    }
    .hero-actions {
      display: grid;
    }
    .text-link {
      width: 100%;
    }
    .issue-bar span,
    .section-label,
    .feature-main,
    .thesis,
    .confidence,
    .investment-list li,
    .desk-module,
    .method-title,
    .method-item,
    .beyond-title,
    .beyond-content {
      padding-right: 1rem;
      padding-left: 1rem;
    }
    .issue-bar span:last-child {
      display: none;
    }
    .issue-bar {
      grid-template-columns: 1fr;
    }
    .section-label {
      grid-template-columns: 1fr;
      gap: 0.25rem;
      padding-top: 0.7rem;
      padding-bottom: 0.7rem;
    }
    .section-label > span {
      line-height: 1.5;
    }
    .feature-main {
      padding-top: 3rem;
      padding-bottom: 3rem;
    }
    .feature-kicker {
      flex-direction: column;
    }
    .feature-main h3 {
      font-size: clamp(2.25rem, 11vw, 3.5rem);
    }
    .investment-list li,
    .investment-list li.has-preview {
      grid-template-columns: 1fr;
      gap: 1rem;
      min-height: 0;
    }
    .investment-list li.has-preview .entry-preview {
      grid-column: 1;
    }
    .row-link {
      grid-column: 1;
    }
    .method-grid {
      grid-template-columns: 1fr;
    }
    .method-item,
    .method-item:nth-child(2n) {
      border-right: 0;
      border-bottom: 1px solid var(--border-subtle);
    }
    .method-item:last-child {
      border-bottom: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-grid {
      animation: none;
    }
  }
</style>
