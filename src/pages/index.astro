---
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { getPublishedEntries } from '../lib/entries.mjs';
import { sortEntriesByPublishedNewestFirst } from '../lib/entry-utils.mjs';

const allArticles = sortEntriesByPublishedNewestFirst(
  await getPublishedEntries({ format: 'article' }),
);
---

<Base
  title="Deep Value"
  description="记录我正在观察、理解和实践的事情。"
>
  <div class="homepage-index">
    <section class="all-articles-section" aria-labelledby="all-articles-heading">
      <div class="section-label">
        <div>
          <p data-i18n="index.entryIndex">ARTICLE INDEX</p>
          <h1 id="all-articles-heading" data-i18n="index.articleList">全部文章</h1>
        </div>
        <span>{String(allArticles.length).padStart(2, '0')} <span data-i18n="index.published">PUBLISHED</span></span>
      </div>
      <EntryList
        entries={allArticles}
        emptyText="暂时没有已发布的文章。"
        emptyTextKey="publication.blogEmpty"
        dateMode="published"
      />
    </section>
  </div>
</Base>

<style>
  .homepage-index {
    min-height: calc(100svh - var(--header-height));
    margin-top: var(--header-height);
    color: var(--text-primary);
    background: var(--surface-primary);
  }

  .all-articles-section {
    width: min(1180px, calc(100% - 3rem));
    margin: 0 auto;
    padding: var(--space-6) 0 var(--space-7);
  }

  .section-label {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-label p,
  .section-label h1,
  .section-label > span {
    margin: 0;
  }

  .section-label p,
  .section-label > span {
    color: var(--metadata-primary);
    font-family: var(--font-data);
    font-size: var(--caption);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .section-label h1 {
    margin-top: 0.45rem;
    font-size: var(--step-3);
    font-weight: var(--weight-medium);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  @media (max-width: 560px) {
    .all-articles-section {
      width: min(100% - 2rem, 1180px);
      padding-top: var(--space-5);
    }

    .section-label {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
