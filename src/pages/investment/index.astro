---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getPublishedEntries } from '../../lib/entries.mjs';

const entries = await getPublishedEntries({ domain: 'investment' });

const sections = [
  { href: '/investment/', label: '全部', i18nKey: 'publication.all' },
  { href: '/investment/?section=commodities', label: '大宗商品', i18nKey: 'section.commodities' },
  { href: '/investment/?section=industries-companies', label: '产业与公司', i18nKey: 'section.industries' },
  { href: '/investment/?section=macro-cycles', label: '宏观与周期', i18nKey: 'section.macro' },
  { href: '/investment/?section=markets-trading', label: '市场与交易', i18nKey: 'section.markets' },
];
---

<Base title="投资研究 - Deep Value" description="大宗商品、产业、宏观、市场与交易研究">
  <header class="publication-header">
    <div class="publication-kicker">
      <p>INVESTMENT RESEARCH</p>
      <span>01 / PRIMARY DOMAIN</span>
    </div>
    <div class="publication-copy">
      <h1 data-i18n="publication.investmentTitle">投资研究</h1>
      <p class="publication-description" data-i18n="publication.investmentDescription">
        围绕大宗商品、产业与公司、宏观周期以及市场与交易展开研究。文章沉淀可复用的判断，日志保留证据与观点的演变。
      </p>
    </div>
  </header>

  <nav class="section-index" data-section-index aria-label="投资研究栏目">
    <p data-i18n="publication.sectionIndex">SECTION INDEX</p>
    <ol>
      {sections.map(section => (
        <li><a href={section.href} data-i18n={section.i18nKey}>{section.label}</a></li>
      ))}
    </ol>
  </nav>

  <EntryList
    entries={entries}
    emptyText="投资研究暂时没有已发布内容；后续文章与研究日志会在发布后出现在这里。"
    emptyTextKey="publication.investmentEmpty"
    groupByFormat
  />
</Base>
